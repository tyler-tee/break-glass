# Every value in this file is optional. The app runs with no .env at all: on first boot it
# logs a one-time setup code, and you finish setup (password, API keys, home, places) in the
# browser. Values set here win over anything saved in the app and show there as read-only.
# This file is a reference for the advanced, pre-seeded path.
# HTTP port
PORT=3000
# SQLite database file path
DATABASE_PATH=./data/app.db
# Optional. Admin password hash (generate with: npm run hash-password). Leave unset to set
# the password in the browser instead.
# ADMIN_PASSWORD_HASH=
# Optional. Session signing secret, at least 32 characters. Generated automatically if absent.
# SESSION_SECRET=
# Google Places API key (optional)
GOOGLE_PLACES_API_KEY=
# LLM provider. Unset = on when an Anthropic key is saved in the app or set below; set to
# none to force drafting/extraction off (a key saved in the app is then kept but unused).
# LLM_PROVIDER=none
# LLM API key (optional)
LLM_API_KEY=
# Model used for extraction
LLM_EXTRACT_MODEL=claude-haiku-5-5
# Model used for drafting
LLM_DRAFT_MODEL=claude-opus-5-5
# Consecutive refresh failures before flagging
REFRESH_FAILURE_THRESHOLD=3
# Rating change that triggers a warning
RATING_WARN_DELTA=0.5
# Max Places API calls per period
PLACES_CALL_CAP=200
# Max Places API calls per calendar month, across all runs. Requests with rating fields
# bill at the Enterprise SKU, whose free tier is about 1,000 calls a month, so 800 leaves headroom.
PLACES_MONTHLY_CAP=800
# Allowed protocol source domains (raw string, comma-separated)
PROTOCOL_SOURCE_ALLOWLIST=
