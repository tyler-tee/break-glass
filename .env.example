# HTTP port
PORT=3000
# SQLite database file path
DATABASE_PATH=./data/app.db
# Admin password hash (generate with: npm run hash-password). Keep the single quotes: the hash contains "$".
ADMIN_PASSWORD_HASH=''
# Session signing secret, at least 32 characters
SESSION_SECRET=
# Google Places API key (optional)
GOOGLE_PLACES_API_KEY=
# LLM provider: anthropic or none
LLM_PROVIDER=none
# LLM API key (optional)
LLM_API_KEY=
# Model used for extraction
LLM_EXTRACT_MODEL=claude-haiku-5-5
# Model used for drafting
LLM_DRAFT_MODEL=claude-opus-5-5
# Consecutive refresh failures before flagging
REFRESH_FAILURE_THRESHOLD=3
# Rating change that triggers a warning
RATING_WARN_DELTA=0.5
# Max Places API calls per period
PLACES_CALL_CAP=200
# Max Places API calls per calendar month, across all runs. Requests with rating fields
# bill at the Enterprise SKU, whose free tier is about 1,000 calls a month, so 800 leaves headroom.
PLACES_MONTHLY_CAP=800
# Allowed protocol source domains (raw string, comma-separated)
PROTOCOL_SOURCE_ALLOWLIST=
